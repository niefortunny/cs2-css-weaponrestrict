<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UmbrellaWeaponRestrict</AssemblyName>
    <RootNamespace>UmbrellaWeaponRestrict</RootNamespace>
    <Version>1.0.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" PrivateAssets="all" ExcludeAssets="runtime" />

    <Reference Include="CoreSettings.Api">
      <HintPath>lib/CoreSettings.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MenuManagerApi">
      <HintPath>lib/MenuManagerApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
